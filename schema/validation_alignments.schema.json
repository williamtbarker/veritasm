{
  "descriptor_schema_version": "1.0",
  "artifact": "alignments.tsv",
  "artifact_schema_version": "1.0",
  "format": "tsv",
  "encoding": "UTF-8",
  "line_ending": "LF",
  "final_newline": true,
  "delimiter": "TAB",
  "header": true,
  "empty_data_rows_allowed": true,
  "missing_value": "NA",
  "columns": [
    "schema_version",
    "contig_id",
    "contig_length",
    "status",
    "molecule_id",
    "truth_class",
    "topology",
    "strand",
    "oriented_reference_start",
    "reference_bases_consumed",
    "matches",
    "mismatches",
    "inserted_bases",
    "deleted_bases",
    "edit_distance",
    "alignment_columns",
    "equally_best_molecule_strands",
    "cigar"
  ],
  "algorithm": "exact_substring_then_deterministic_unit_cost_fitting_alignment_v2",
  "coordinate_note": "oriented_reference_start is relative to the selected + or - truth orientation; circular values begin in the first truth revolution"
}
