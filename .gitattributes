# Source text uses LF; fixtures and evidence retain their exact bytes.
*.rs text eol=lf
*.sh text eol=lf
*.toml text eol=lf whitespace=-blank-at-eof
*.md text eol=lf whitespace=-blank-at-eol,-blank-at-eof
LICENSE text eol=lf whitespace=-blank-at-eof
fuzz/corpus/** -text -whitespace
examples/reads.fasta -text -whitespace
examples/data/** -text -whitespace
docs/verification/** -text -whitespace
